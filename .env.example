# ==============================================================================
# SafeCall (HackYeah 2026) - Root Environment Configuration
# Copy this file to .env:  cp .env.example .env
#
# NOTE: The application works 100% OUT OF THE BOX WITH ZERO KEYS!
# (Automatically falls back to browser speech synthesis and local mock SMS).
# ==============================================================================

# --- ElevenLabs Conversational AI (Optional) ---
# To talk with a real AI conversational voice agent:
# Get free credentials at https://elevenlabs.io -> Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Service Ports & Network URLs (Defaults for local development) ---
PORT=4000
BACKEND_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:4000
APP_ENV=development
