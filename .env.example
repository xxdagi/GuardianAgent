# ==============================================================================
# SafeCall (HackYeah 2026) - Root Environment Configuration
# Copy this file to .env:  cp .env.example .env
# All services (Backend, BFF, Frontend) share this single configuration file.
# NOTE: The app works out of the box with 0 keys! (Offline browser voice + mock SMS)
# ==============================================================================

# --- Application & Ports ---
APP_ENV=development
PORT=4000
BACKEND_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:4000

# --- ElevenLabs Voice AI (Optional - conversational voice assistant) ---
# Sign up at https://elevenlabs.io (Free tier available, no credit card required)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Google Gemini AI (Optional - LLM reasoning) ---
# Free tier at https://aistudio.google.com (no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Emergency & Notification Provider ---
# "mock" simulates SMS in memory and displays incoming alerts in http://localhost:5173/sms
ALERT_PROVIDER=mock

# --- Frontend Settings (Public Vite Variables) ---
VITE_API_BASE_URL=/api
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
