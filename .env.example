# ==============================================================================
# SafeCall (HackYeah 2026) - Root Environment Configuration
# Copy this file to .env:  cp .env.example .env
#
# NOTE: Without API keys, the app will run using a robotic offline speech synthesizer.
# For the full, realistic AI experience, obtain the API keys from the author 
# (or generate your own) and paste them below.
# ==============================================================================

# --- ElevenLabs Conversational AI (Optional) ---
# To talk with a real AI conversational voice agent:
# Get free credentials at https://elevenlabs.io -> Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# --- Service Ports & Network URLs (Defaults for local development) ---
PORT=4000
BACKEND_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:4000
APP_ENV=development
