# Copy to .env. Never commit .env. Use placeholder values only here.
APP_ENV=development
CORS_ORIGINS=http://localhost:4000

# OpenAI Realtime API settings (only needed when connecting live voice agent)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy

# Alert Notifier Provider
# Default "mock" simulates SMS delivery in memory and powers the live dispatcher dashboard
ALERT_PROVIDER=mock

# Optional Telegram Bot (free push notification fallback if desired)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
