# Copy to .env. Never commit .env. Use placeholder values only here.
APP_ENV=development
CORS_ORIGINS=http://localhost:4000

# LLM Reasoning: Google Gemini Flash (Free Tier, NO CREDIT CARD required: https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Voice Generation: ElevenLabs (Free Tier 10,000 credits, NO CREDIT CARD required: https://elevenlabs.io)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Alert Notifier Provider
# "mock" simulates SMS delivery in memory and powers the live dispatcher dashboard.
# (Real SMS/Telegram push notifiers were removed as unnecessary for the demo).
ALERT_PROVIDER=mock

